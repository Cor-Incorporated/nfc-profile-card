rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ヘルパー関数
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isValidProfile() {
      // profile.linksが存在する場合のみ検証（存在しない場合は許可）
      return !('profile' in request.resource.data) || 
             !('links' in request.resource.data.profile) || 
             request.resource.data.profile.links.size() <= 10;
    }

    // A public URL and its redirect history are assigned by the server.
    // A new client document may only use its own UID fallback URL.
    function isValidNewPublicIdentity(userId) {
      return !request.resource.data.keys().hasAny([
               'previousUsernames', 'usernameConfirmed',
               'usernameRotatedAt', 'usernameRotatedBy',
               'usernameRotatedBySelf', 'analytics'
             ]) &&
             (request.resource.data.get('username', '') == '' ||
              request.resource.data.get('username', '') == 'u_' + userId);
    }

    function keepsServerControlledPublicIdentity(userId) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'previousUsernames', 'usernameConfirmed',
               'usernameRotatedAt', 'usernameRotatedBy',
               'usernameRotatedBySelf', 'analytics'
             ]) &&
             (request.resource.data.get('username', '') ==
                resource.data.get('username', '') ||
              ((resource.data.get('username', '') == '' ||
                resource.data.get('username', '') == null) &&
               request.resource.data.get('username', '') == 'u_' + userId));
    }
    
    // ユーザードキュメント
    match /users/{userId} {
      // プロフィールページは誰でも読める（公開プロフィール）
      allow read: if true;
      
      // 本人のみ作成・更新可能（Firebase Auth使用）
      allow create: if isOwner(userId) && isValidNewPublicIdentity(userId);
      allow update: if isOwner(userId) && isValidProfile() &&
                      keepsServerControlledPublicIdentity(userId);
      // Deletion would let a client erase server-owned URL history and view
      // counters, then recreate the same UID. Account removal must use Admin SDK.
      allow delete: if false;
      
      // プロフィールサブコレクション（公開プロフィール用）
      match /profile/{docId} {
        // 誰でも読める（公開プロフィール表示用）
        allow read: if true;
        // 本人のみ作成・更新可能
        allow write: if isOwner(userId);
      }
      
      // スキャン済み名刺サブコレクション（プライベート）
      match /businessCards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      
      // 連絡先サブコレクション（プライベート）
      match /contacts/{contactId} {
        allow read, write: if isOwner(userId);
      }
      
      // アナリティクスサブコレクション（読み取りのみ）
      match /analytics/{analyticsId} {
        allow read: if isOwner(userId);
        allow write: if false; // Cloud Functionsからのみ
      }
    }
    
    // NFCカード管理（管理者のみ）
    match /cards/{cardId} {
      allow read: if true; // カードの有効性確認のため
      allow write: if false; // Cloud Functionsからのみ
    }
    
    // 注文管理（ユーザー自身の注文のみ）
    match /orders/{orderId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || 
         request.auth.token.admin == true);
      allow create: if isAuthenticated() && 
        request.auth.uid == request.resource.data.userId;
      allow update: if false; // Cloud Functions/Webhookからのみ
    }
  }
}
