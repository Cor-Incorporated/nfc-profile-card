# Firebase Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nfc-profile-card.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nfc-profile-card
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nfc-profile-card.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Private - Server only)
FIREBASE_ADMIN_PROJECT_ID=nfc-profile-card
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY=replace_with_service_account_private_key

# Local OCR inference (default scan path)
# Production: authenticated public gateway -> GB10 dual OCR adapter.
# Vercel must never call a Tailscale/LAN node address or individual engine port.
OCR_PROVIDER=local
OCR_INFERENCE_URL=https://replace-with-ocr-gateway.example.com
OCR_INFERENCE_API_KEY=replace_with_dedicated_gateway_token
OCR_INFERENCE_MODE=live
OCR_ENABLE_GEMINI_FALLBACK=false
OCR_TOTAL_TIMEOUT_MS=28000
OCR_INFERENCE_TIMEOUT_MS=25000
OCR_GEMINI_FALLBACK_TIMEOUT_MS=18000
# Laptop mock sidecar ONLY. Port 8090 is not for production.
# OCR_INFERENCE_URL=http://127.0.0.1:8090
# OCR_INFERENCE_MODE=mock
# Direct engine development requires both URLs explicitly and is not production.
# OCR_PPOCR_URL=http://127.0.0.1:8093
# OCR_VLM_URL=http://127.0.0.1:8092/v1

# Google Gemini API (last-resort only; not the default scan path)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# NFC Card Pricing (in JPY)
NEXT_PUBLIC_CARD_PRICE_INITIAL=3000
NEXT_PUBLIC_CARD_PRICE_ADDITIONAL=500

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="NFC Profile Card"
