# Firebase Configuration (Public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=nfc-profile-card.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=nfc-profile-card
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=nfc-profile-card.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin (Private - Server only)
FIREBASE_ADMIN_PROJECT_ID=nfc-profile-card
FIREBASE_ADMIN_CLIENT_EMAIL=your_service_account_email
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Gemini API
# Server only. Set one key. NFC_GEMINI_API_KEY takes priority if defined.
# NFC_GEMINI_API_KEY=your_nfc_gemini_api_key
# Legacy deployments may keep GEMINI_API_KEY instead.
# GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# Experimental Ollama OCR (off unless explicitly enabled). Never expose :11434 publicly.
# NFC_OCR_OLLAMA_EXPERIMENT accepts only true or false; unset/false uses Gemini.
# Remote use requires an OCR-scoped gateway Bearer plus Cloudflare Access pair.
# The HTTPS endpoint is limited to one explicitly selected *.tapforge.org hostname.
# A verified dedicated *.tapforge.org Access hostname can be selected explicitly.
# Omit this setting for the existing nfc-ocr.tapforge.org hostname.
# The gateway's Ollama route and selected model must be verified before enabling.
# NFC_OCR_OLLAMA_EXPERIMENT=true
# NFC_OCR_OLLAMA_GATEWAY_URL=https://nfc-ocr.tapforge.org/v1/ocr/ollama/chat
# NFC_OCR_OLLAMA_MODEL=gemma4:12b
# NFC_OCR_OLLAMA_GATEWAY_TOKEN=replace_with_ocr_scoped_gateway_token
# NFC_OCR_OLLAMA_ACCESS_HOSTNAME=your-verified-ocr-host.tapforge.org
# NFC_OCR_OLLAMA_ACCESS_CLIENT_ID=replace_with_service_token_client_id
# NFC_OCR_OLLAMA_ACCESS_CLIENT_SECRET=replace_with_service_token_client_secret

# Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# NFC Card Pricing (in JPY)
NEXT_PUBLIC_CARD_PRICE_INITIAL=3000
NEXT_PUBLIC_CARD_PRICE_ADDITIONAL=500

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="NFC Profile Card"
